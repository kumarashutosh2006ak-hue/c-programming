#include<stdio.h>
#include<stdlib.h>

void angle_class(long long angle);
int main(){
    
    long long a;
    scanf("%lld",&a);
    
    //function call
    angle_class(a);
   
    return 0;
}
void angle_class(long long angle){
    
    if(angle>360){
        angle=angle%360;
        if(angle==0){
           printf("Full Rotation\n"); 
           exit(0);
        }
    }
    
    //conditions for angle classes
    if(angle==0 || angle<90){
        printf("Acute Angle\n");
        exit(0);
    }
    else if (angle == 90){
        printf("Right Angle\n");
        exit(0);
    }
    else if(angle == 180){
        printf("Straight Angle\n");
        exit(0);
    }
    else if(angle>90 && angle<180){
        printf("Obtuse Angle\n");
        exit(0);
    }
    else if(angle>180 && angle<360){
        printf("Reflex Angle\n");
        exit(0);
    }
    else if(angle == 360){
        printf("Full Rotation\n");
        exit(0);
    }
    exit(0);
}
