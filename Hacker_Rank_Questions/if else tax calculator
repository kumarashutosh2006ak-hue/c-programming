#include <stdio.h>

float tax_cla(float incomee);
int main()
{
    float income;
    scanf("%f",&income);
    
    tax_cla(income);
    
    return 0;
}
float tax_cla(float incomee){
    float tax;
    if(incomee>10000000 || incomee<0){
        printf("INVALID");
        return 0;
    }
    //0
    if(incomee<=250000){
        printf("0.00");
        return 0;
    }
    //1
    else if(incomee>250000 && incomee<=500000){
        tax=0.05*(incomee-250000);
        printf("%.2f",tax);
        return 0;
    }
    //2
    else if(incomee>500000 && incomee<=1000000){
        tax=12500+(0.2*(incomee-500000));
        printf("%.2f",tax);
        return 0;
    }
    //3 
    else if(incomee>1000000 && incomee<=10000000){
        tax=112500+0.3*(incomee-1000000);
        printf("%.2f",tax);
        return 0;
    }
    return 0;
}
