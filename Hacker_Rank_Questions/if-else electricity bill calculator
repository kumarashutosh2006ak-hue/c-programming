#include <stdio.h>

int main()
{
    float n;
    scanf("%f",&n);
    float rate;
    if(n<0 || n>1000000){
        printf("Invalid Input!");
        return 0;
    }
    
    if(n<=100){
        rate=n*5;
    }
    else if(n>100 && n<=300){
        rate=500+(n-100)*7;
    }
    else if(n>300){
        rate=500+1400+(n-300)*10;
    }
    
    if(rate<=1200){
        rate=rate-(0.1*rate);
    }
    printf("The electricity bill is: %.2f.",rate);

    return 0;
}
