#include<stdio.h>

int main() {

    int n1,n2,n3;
    scanf("%d %d %d",&n1,&n2,&n3);

    if(n1>1000 || n1<-1000 || n2>1000 || n2<-1000 || n3>1000 || n3<-1000) {
        return 0;
    }

    if(n1>=n2 && n1>=n3) {
        printf("The largest number is : %d",n1);
        return 0;
    }
    if(n2>=n1 && n2>=n3) {
        printf("The largest number is : %d",n2);
        return 0;
    }
    if(n3>=n1 && n3>=n2) {
        printf("The largest number is : %d",n3);
        return 0;
    }

    return 0;
}
