#include <stdio.h>
int minimum(int ar[],int a);
int main()
{
    int n;
    printf("enter the size of array you want to create: ");
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0; i<=n-1; i++){
        printf("enter number %d: ",i+1);
        scanf("%d",&arr[i]);
    }
    int min=minimum(arr,n);
    printf("min number is: %d",min);

    return 0;
}
int minimum(int ar[],int a){
    
    int min_temp=ar[0];
    
    for(int i=0; i<=a-1; i++){
        if(min_temp>ar[i]){
            min_temp=ar[i];
        }
    }
    return min_temp;
}
