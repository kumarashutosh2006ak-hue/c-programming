#include <stdio.h>
void odd_eve(int ar[],int a);
int main() {

    int n;
    printf("enter the size of array: ");
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0; i<=n-1; i++){
        printf("enter the element %d: ",i+1);
        scanf("%d",&arr[i]);
    }
    odd_eve(arr,n);
    
    return 0;
}
void odd_eve(int ar[],int a){
    int odd=0;
    int eve=0;
    for(int i=0; i<=a-1; i++){
        if(ar[i]%2!=0){
            odd++;
        }
        else{
            eve++;
        }
    }
    printf("the count of odd number is %d\n",odd);
    printf("the count of even number is %d",eve);
    
}
