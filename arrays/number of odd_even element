#include <stdio.h>

int main()
{
    int n;
    printf("enter the size of array: ");
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0; i<=n-1; i++){
        printf("enter the element %d: ",i+1);
        scanf("%d",&arr[i]);
    }
    int eve_count=0;
    int odd_count=0;
    
    for(int i=0; i<=n-1; i++){
        if(arr[i]%2==0){
            eve_count++;
        }
        else{
            odd_count++;
        }
    }
    printf("the count of odd number is %d\n",odd_count);
    printf("the count of even number is %d",eve_count);

    return 0;
}
