#include <stdio.h>
void pos_neg(int ar[],int a);
int main() {

    int n;
    printf("enter the size of array: ");
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0; i<=n-1; i++){
        printf("enter the element %d: ",i+1);
        scanf("%d",&arr[i]);
    }
    pos_neg(arr,n);
    
    return 0;
}
void pos_neg(int ar[],int a){
    int pos=0;
    int neg=0;
    for(int i=0; i<=a-1; i++){
        if(ar[i]>0){
            pos++;
        }
        else if(ar[i]<0){
            neg++;
        }
    }
    printf("the count of positive number is %d\n",pos);
    printf("the count of negative number is %d",neg);
    
}
