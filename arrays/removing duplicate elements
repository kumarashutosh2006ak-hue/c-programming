#include <stdio.h>
#include <stdlib.h>
int *make_array(int size);
int main()
{
    int n;
    printf("enter the size of array: ");
    scanf("%d",&n);
    int *arr=make_array(n);
    for(int i=0; i<n; i++){
        for(int j=i+1; j<n;j++){
            if(arr[i]==arr[j]){
                for(int k=j; k<n-1; k++){
                    arr[k]=arr[k+1];
                }
                n--;
                j--;
            }
        }
    }
    
    for(int i=0; i<n; i++){
        printf("%d ",arr[i]);
    }
    free(arr);
    return 0;
}

int *make_array(int size){
    
    int *temp=(int*)malloc(size*sizeof(int));
    
    for(int i=0; i<size; i++){
        printf("enter value for slot %d: ",i+1);
        scanf("%d",temp+i);
    }
    return temp;
}
