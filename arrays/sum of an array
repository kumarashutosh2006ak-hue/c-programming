#include <stdio.h>

int summation(int arr[],int a);
int main() {

    int n;
    int sum=0;
    printf("enter the size of array: ");
    scanf("%d",&n);
    int arr[n];
    int b =summation(arr,n);
    printf("the sum is : %d",b);
    return 0;
}

int summation(int arr[],int a){
    int sum=0;
    for(int i=0; i<=a-1; i++){
        printf("enter number %d: ",i+1);
        scanf("%d",&arr[i]);
    }
    for(int i=0; i<=a-1; i++){
        sum=sum+arr[i];
    }
    return sum;
}
