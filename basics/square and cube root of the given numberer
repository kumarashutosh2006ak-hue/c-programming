#include <stdio.h>

int main()
{
    int num;
    int cube_root;
    int squ_root;
    
    printf("enter the 1st number: ");
    scanf("%d",&num);
    
    squ_root=num*num;
    cube_root=num*num*num;
    
    printf("the square root of the number is: %d\n",squ_root);
    printf("the cube root of the number is: %d\n",cube_root);

    return 0;
}
