#include <stdio.h>
int main()
{
    int num;
    int factorial(int a);
    printf("enter a number: ");
    scanf("%d",&num);
    
    int c= factorial(num);
    printf("%d",c);

    return 0;
}

int factorial(int a){
    int fact=1;
    for(int i=1; i<=a; i++){
        fact=fact*i;
    }
    return fact;
}
