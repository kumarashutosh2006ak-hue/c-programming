#include <stdio.h>
int gcd(int a, int b);
int main()
{
    int num1;
    int num2;
    printf("enter the 1st number: ");
    scanf("%d",&num1);
    printf("enter the 2nd number: ");
    scanf("%d",&num2);
    
    int res =gcd(num1, num2);
    printf("the gcd of 1st and 2nd number is: %d",res);
    
    return 0;
}

int gcd(int a, int b){
    int temp=1;
    for(int i=1; i<=a && i<=b; i++){
        if(a%i==0 && b%i==0){
            temp=i;
        }
    }
    return temp;
}
