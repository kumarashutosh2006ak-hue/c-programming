#include <stdio.h>

int main()
{
    int factorial(int a);
    int num;
    printf("enter a number: ");
    scanf("%d",&num);
    
    int c= factorial(num);
    printf("%d",c);

    return 0;
}

int factorial(int a){
    if(a==1 || a==0){
        return 1;
    }
    
    return a*factorial(a-1);
}
