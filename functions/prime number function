#include <stdio.h>

int prime(int a);
int main()
{
    int n;
    printf("enter a number: ");
    scanf("%d",&n);
    
    prime(n);

    return 0;
}

int prime(int a){
    if(a<=1){
        printf("it is a not prime number");
        return 0;
    }
    if(a==2){
        printf("it is a prime number");
        return 0;
    }
    for(int i=2; i<a; i++){
        if(a%i==0){
            printf("not a prime number");
            return 0;
        }
    }
    
    printf("it is a prime number");
    return 0;
}
