#include <stdio.h>

int reverse(int a);
int main()
{
    int n;
    printf("enter the number: ");
    scanf("%d",&n);
    
    int rev=reverse(n);
    printf("%d",rev);
    return 0;
}

int reverse(int a){
    int rev=0,rem=0;
    
    while(a!=0){
        rem=a%10;
        rev=rev*10+rem;
        a=a/10;
    }
    return rev;
}
