#include <stdio.h>

int main()
{
    int num1;
    int num2;
    int gcd;
    printf("program to find GCD\n");
    printf("enter the 1st number: ");
    scanf("%d",&num1);
    printf("enter the 2nd number: ");
    scanf("%d",&num2);
    
    for(int i=1; i<=num1 && i<=num2; i++){
        if(num1%i==0 && num2%i==0){
            gcd=i;
        }
    }
    printf("gcd of %d and %d is %d",num1,num2,gcd);
    
    return 0;
}
