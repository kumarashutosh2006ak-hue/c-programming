#include <stdio.h>

int main()
{
    int num1;
    int num2;
    int lcm;
    printf("program to find LCM\n");
    printf("enter the 1st number: ");
    scanf("%d",&num1);
    printf("enter the 2nd number: ");
    scanf("%d",&num2);
    
    for(int i=1; i<=num1*num2; i++){
        if(i%num1==0 && i%num2==0){
            lcm=i;
            break;
        }
    }
    printf("LCM of %d and %d is %d",num1,num2,lcm);
    
    return 0;
}
