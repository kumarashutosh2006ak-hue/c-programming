#include <stdio.h>

int main()
{
    int str, endr;
    printf("enter range of numbers to count prime numbers: \n");
    printf("enter starting range\n");
    scanf("%d",&str);
    printf("enter ending range\n");
    scanf("%d",&endr);
    
    int count;
    int prmno=0;
    
   for(int k=str; k<=endr; k++){
       count=0;
       for(int i=1; i<=k; i++){
        if(k%i==0){
            count++;
        }
       }
       
       if(count==2){
           prmno++;
           printf("%d ",k);
       }
   } 
   printf("\n");
   printf("these are %d prime numbers in the give range",prmno);
   
    
    
    return 0;
}
