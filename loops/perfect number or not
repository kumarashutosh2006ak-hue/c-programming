#include <stdio.h>

int main()
{
    int n;
    printf("enter a number to check if it is a perfect number or not: ");
    scanf("%d",&n);
    
    int sum=0;
    int cont=n;
    
    for(int i=1; i<n; i++){
        if(n%i==0){
            sum=sum+i;
        }
    }
    if(sum==cont){
        printf("it is a perfect number");
    }
    else{
        printf("it is not a perfect number");
    }
    
    return 0;
}
