#include <stdio.h>

int main()
{
    int n;
    printf("enter a number to check if it is a prime number or not: ");
    scanf("%d",&n);
    
    int count=0;
    
    for(int i=1; i<=n; i++){
        if(n%i==0){
            count++;
        }
    }
    if(count==2){
        printf("it is a prime number");
    }
    else{
        printf("it is not a prime number");
    }
    
    return 0;
}
