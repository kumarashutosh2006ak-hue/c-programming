#include <stdio.h>

int main()
{
    char a;
    scanf("%c",&a);
    if(a>='A' && a<='Z'){
        printf("it is a alphabet");
        return 0;
    }
    else if(a>='a' && a<='z'){
        printf("it is a alphabet");
        return 0;
    }
    else if(a>='0' && a<='9'){
        printf("it is a number digit");
        return 0;
    }
    else{
        printf("it is a special character");
        return 0;
    }

    return 0;
}
