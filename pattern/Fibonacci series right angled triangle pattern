#include <stdio.h>

int main()
{
    int n;
    printf("enter the height of triangle: ");
    scanf("%d",&n);
    
    int num1=0;
    int num2=1;
    
    for(int i=1; i<=n; i++){
        for(int j=1; j<=i; j++){
            printf("%-4d",num1);
            int temp=num1+num2;
            num1=num2;
            num2=temp;
        }
        printf("\n");
    }

    return 0;
}
