#include <stdio.h>

int main()
{
    int n;
    printf("enter the height of arrow: ");
    scanf("%d",&n);
    
    int count=1;
    
    for(int i=1; i<=n; i++){
        for(int k=1; k<=n-i; k++){
            printf("  ");
        }
        for(int j=1; j<=i; j++){
            printf("%-4d",count);
            count++;
        }
        printf("\n");
    }

    return 0;
}
