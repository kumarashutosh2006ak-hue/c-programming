#include <stdio.h>

int main()
{
    int n;
    char chr;
    printf("enter the height of triangle: ");
    scanf("%d",&n);
    printf("enter the character you want the trianlge to be made up of: ");
    scanf(" %c",&chr);
    
    for(int i=1; i<=n; i++){
        for(int k=1; k<=n-i; k++){
            printf(" ");
        }
        for(int j=1; j<=2*i-1; j++){
            printf("%c",chr);
        }
        printf("\n");
    }
    
    return 0;
}
