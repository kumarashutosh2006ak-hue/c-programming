#include <stdio.h>

int main()
{
    int n;
    printf("enter the size of butterfly: ");
    scanf("%d",&n);
    
    for(int i=1; i<=n; i++){
        for(int j=1; j<=i; j++){
            printf("*");
        }
        for(int k=1; k<=2*(n-i); ++k){
            printf(" ");
        }
        for(int j=1; j<=i; j++){
            printf("*");
        }
        printf("\n");
    }
    for(int i=1; i<=n-1; i++){
        for(int j=1; j<=n-i; j++){
            printf("*");
        }
        for(int k=1; k<=i*2; k++){
            printf(" ");
        }
        for(int j=1; j<=n-i; j++){
            printf("*");
        }
        printf("\n");
    }
   

    return 0;
}
