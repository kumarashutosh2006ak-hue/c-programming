#include <stdio.h>

int main()
{
    int n;
    char chr;
    printf("enter the height of diamond: ");
    scanf("%d",&n);
    printf("enter the character you want the diamond to be made up of: ");
    scanf(" %c",&chr);
    
    n=(n+1)/2;
    
    for(int i=1; i<=n-1; i++){
        for(int k=1; k<=n-i; k++){
            printf(" ");
        }
        for(int j=1; j<=(2*i-1); j++){
            printf("%c",chr);
        }
        printf("\n");
    }
    for(int i=1; i<=n; i++){
        for(int j=1; j<=i-1; j++){
            printf(" ");
        }
        for(int k=1; k<=2*(n-i+1)-1; k++){
            printf("%c",chr);
        }
        printf("\n");
    }
    
    return 0;
}
