#include <stdio.h>

int main()
{
    int n;
    int k=1;
    printf("enter height of the triangle: ");
    scanf("%d",&n);
    
    for(int i=1; i<=n*2-1; i++){
        printf("*");
    }
    printf("\n");
   for(int i=1; i<=n; ++i){
       if(i==n){
           for(int l=1; l<=2*n-1; l++){
               printf("*");
           }
       }
       for(int j=1; j<=n-i; ++j){
           printf("*");
       }
       for(int k=1; k<=i; k++){
           printf(" ");
       }
       for(k=1; k<=i-1; k++){
           printf(" ");
       }
       for(int j=1; j<=n-i; ++j){
           printf("*");
       }
       printf("\n");
   }
    
    return 0;
}
