#include <stdio.h>

int main()
{
    int n;
    printf("enter height of inverted pyramid: ");
    scanf("%d",&n);
    
    for(int i=1; i<=n; i++){
        for(int j=2; j<=i; j++){
            printf(" ");
        }
        for(int k=1; k<(2*(n-i+1)); k++){
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
