#include <stdio.h>

int main()
{
    int n;
    printf("enter height of the pascal triangle: ");
    scanf("%d",&n);
    int temp=1;
    
    for(int i=1; i<=n; i++){
        for(int j=1; j<=n-i; j++){
            printf(" ");
        }
        for(int k=1; k<=i; k++){
            if(k==1 || k==i){
                temp=1;
            }
            else{
                temp=temp*(i-k+1)/(k-1);            }
            printf("%-2d",temp);
        }
        printf("\n");
    }

    return 0;
}
